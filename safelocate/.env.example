# --- Core ---
APP_ENV=production                # use "development" locally (disables Secure cookies)
SECRET_KEY=change-me              # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=mysql+pymysql://safelocate:password@localhost:3306/safelocate
DB_SSL_CA=                        # optional path to CA cert for managed MySQL (e.g. Aiven)
TRUST_PROXY=true                  # true behind Render/Railway/Nginx

# --- Email (OTP + invite notices) ---
MAIL_DEV_MODE=false               # true = print OTPs to server log (local testing ONLY)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASSWORD=secret
MAIL_FROM=SafeLocate <no-reply@yourdomain.com>
